# ─── Required ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Groq model — change to any Groq-supported model ─────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.0

# ─── App settings ─────────────────────────────────────────────────────────────
APP_NAME=personal-ai-agent
APP_VERSION=0.1.0
DEBUG=false
HOST=127.0.0.1
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
LOG_DIR=logs
AUDIT_LOG_FILE=logs/audit.jsonl

# ─── Agent behaviour ─────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_REQUIRE_CONFIRMATION=true

# ─── Path security — comma-separated list of allowed root directories ─────────
# The agent will ONLY operate on files within these directories.
# Add your user folder and any project directories you want the agent to access.
# ALLOWED_BASE_PATHS=C:\Users,C:\Temp,C:\Projects
ALLOWED_BASE_PATHS=C:\Users,C:\Temp

# ─── Terminal security ────────────────────────────────────────────────────────
# Set to true to allow the run_command tool. Default: false (disabled).
ALLOW_SHELL_COMMANDS=false

# Comma-separated list of executables the terminal tool may run.
# Only used when ALLOW_SHELL_COMMANDS=true.
ALLOWED_COMMANDS=python,node,npm,git,docker

# ─── Voice Interface ─────────────────────────────────────────────────────────
VOICE_ENABLED=true
STT_PROVIDER=groq
TTS_PROVIDER=system
WAKE_WORD_ENABLED=false
WAKE_WORD=Jarvis

# ─── Storage (future) ────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db
# REDIS_URL=redis://localhost:6379/0

